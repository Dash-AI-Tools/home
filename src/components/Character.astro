---
// A roster character built only from the Dash AI mark: slab body, slash ribbon.
interface Props { kind: 'lead' | 'egg' | 'guest'; class?: string; }
const { kind, class: className } = Astro.props;
---
<svg class:list={['char', `char-${kind}`, className]} viewBox="0 0 1770 574" aria-hidden="true" focusable="false">
  <g class="body">
    <path class="slab" d="M130 0H1356L1010 574H130A130 130 0 0 1 0 444V130A130 130 0 0 1 130 0Z" />
    <path class="slash" d="M1489 0H1738Q1790 0 1758 52L1428 574H1160Q1108 574 1140 522Z" />
  </g>
  {kind === 'egg' ? (
    <g class="face">
      <path class="lid" d="M300 250Q380 300 460 250" />
      <path class="lid" d="M600 250Q680 300 760 250" />
      <path class="mouth" d="M470 390Q530 420 590 390" />
    </g>
  ) : (
    <g class="face">
      <circle class="eye" cx="380" cy="240" r="84" />
      <circle class="eye" cx="680" cy="240" r="84" />
      <circle class="pupil" data-px="380" data-py="240" cx="380" cy="240" r="38" />
      <circle class="pupil" data-px="680" data-py="240" cx="680" cy="240" r="38" />
      <path class="mouth" d="M440 395Q530 465 620 395" />
    </g>
  )}
</svg>
