---
import Base from '../layouts/Base.astro';
import ProjectLogo from '../components/ProjectLogo.astro';

const org = 'https://github.com/Dash-AI-Tools';
const repo = `${org}/doc-my-repos`;

const shots = [
  { id: 'home', tab: 'Home', alt: 'The DocMyRepos home page: a search box and a grid of repository cards', cap: 'One search box and one card per synced repository.' },
  { id: 'repo', tab: 'Repo space', alt: 'A repository page with its README, the documentation tree and the code owners panel', cap: 'Each repository gets its README, its code owners and a tree of its docs folder.' },
  { id: 'doc', tab: 'A document', alt: 'A document page with code blocks, a table, a task list and a Mermaid diagram, next to an outline and the documentation tree', cap: 'GitHub-flavored Markdown with highlighted code and Mermaid diagrams, beside an outline, and a comments section.' },
  { id: 'search', tab: 'Search', alt: 'Search results for the word deployment with highlighted snippets and repository, type and tag filters', cap: 'Full-text search across every repo, with highlighted snippets and filters.' },
  { id: 'palette', tab: 'Ctrl/Cmd+K', alt: 'The quick search palette listing documents that match deployment', cap: 'The command palette jumps to any document from anywhere.' },
  { id: 'okf-filters', tab: 'OKF filters', alt: 'An OKF repository with the Concept and Decision types selected in the filter panel', cap: 'Repos that use Open Knowledge Format can be filtered by concept type, tag and status.' },
  { id: 'okf-metadata', tab: 'OKF metadata', alt: 'A document page with its OKF metadata card: type, status, tags, sources, dates and other fields', cap: 'Each OKF document also gets a metadata card.' },
  { id: 'api-reference', tab: 'API reference', alt: 'The API reference page of a repository, rendered from its openapi.yaml with servers, tags and operations', cap: 'OpenAPI and Swagger files are shown as a read-only API reference.' },
  { id: 'workspace', tab: 'Admin setup', alt: 'Workspace configuration with the GitHub connection status, the GitHub App fields and the docs folders', cap: 'Admins set up the GitHub App and the repositories from the app, not from config files.' },
  { id: 'status', tab: 'Sync status', alt: 'The sync status page with the last run and the state of every repository', cap: 'The status page shows the last run and the state of every repository.' },
];

const spec = [
  ['Repo spaces', 'Every repository you choose gets its own space: the main README, the code owners from CODEOWNERS and a tree of the docs folder.'],
  ['One search', 'Postgres full-text search across all synced repos, weighted by title, headings, description and body, with highlighted snippets, facets and a Ctrl/Cmd+K palette.'],
  ['Ask the docs', 'An optional assistant answers questions in plain language from the synced documents and cites the exact sections. It stays off until an admin sets it up, and you bring your own model: Anthropic, or any OpenAI-compatible endpoint, including local ones.'],
  ['AI agent access', 'Claude Code, Cursor and other agents read your docs through a read-only MCP endpoint. Each user creates a personal token that is shown once and can be revoked.'],
  ['API reference', 'OpenAPI 3.0/3.1 and Swagger 2.0 files found in a repository are shown on a read-only reference page.'],
  ['Comments', 'Signed-in users discuss a document on its page, and admins can answer as the organization and moderate. Comments live in the portal, not in GitHub.'],
  ['Safe Markdown', 'Plain GitHub-flavored Markdown with Shiki highlighting and Mermaid diagrams. Documents are untrusted: output is sanitized and .mdx is never executed.'],
  ['OKF filters', 'When a repo uses Open Knowledge Format, filter by concept type, tags and status, and switch between the OKF view and a folder tree. Repos without it show no OKF interface.'],
  ['Your branding', 'Admins set the organization name, page title, colors and logo from the app. Light, dark or system theme, including code blocks and diagrams.'],
  ['Read-only access', 'It installs as a read-only GitHub App, never a personal access token. GitHub is not called while you browse: pages and search read Postgres only. The portal sits behind a login with admin and user roles.'],
  ['Stays fresh', 'GitHub webhooks re-sync a repo when its default branch changes, and a scheduled full sync catches missed deliveries. Syncs are incremental, and a failed sync keeps the previous content.'],
];
---
<Base
  title="DocMyRepos · Dash AI"
  description="DocMyRepos searches and showcases the Markdown documentation of every repository in your GitHub organization. Open source, MIT, self-hosted, with search, Ask the docs and MCP access for AI agents."
  current="doc"
>
      <section class="page-top">
        <div class="wrap">
          <p class="crumb"><a href="/">Projects</a><span aria-hidden="true">/</span><span>DocMyRepos</span></p>
          <div class="page-head">
            <span class="status">Live</span>
            <ProjectLogo class="page-logo" project="doc-my-repos" name="DocMyRepos" ext="png" w={1640} h={496} />
            <h1>Every repo&#8217;s docs, one search box.</h1>
            <p class="lede">DocMyRepos syncs the <code>docs/</code> folder of each repository you choose from your GitHub organization, gives every repo its own space, and gives the whole org one search box. It works with plain Markdown and has first-class support for Open Knowledge Format (OKF).</p>
            <p class="hud-cta">
              <a class="btn" href={repo} rel="noopener">View on GitHub <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 11h11.2l-4.6-4.6L12 5l7 7-7 7-1.4-1.4 4.6-4.6H4v-2Z"/></svg></a>
              <a class="btn ghost" href="#quickstart">Quickstart</a>
            </p>
          </div>
          <dl class="meta" aria-label="At a glance">
            <div><dt>Version</dt><dd class="mono">v0.1.0</dd></div>
            <div><dt>License</dt><dd>MIT</dd></div>
            <div><dt>Language</dt><dd>TypeScript</dd></div>
            <div><dt>Hosting</dt><dd>Self-hosted</dd></div>
            <div><dt>Content</dt><dd>Markdown + OKF</dd></div>
          </dl>
        </div>
      </section>

      <section class="section tint" id="see-it">
        <div class="wrap">
          <div class="section-head">
            <h2>See it working</h2>
            <p>These are DocMyRepos screenshots from a running instance. The documents belong to a fictitious restaurant, Fork &amp; Flame. They follow your light or dark theme.</p>
          </div>
          <div class="shots">
            <div class="shot-tabs" role="tablist" aria-label="Screenshots">
              {shots.map((s, i) => (
                <button role="tab" type="button" id={`tab-${s.id}`} aria-controls={`panel-${s.id}`} aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1}>{s.tab}</button>
              ))}
            </div>
            <div class="shot-stage">
              {shots.map((s, i) => (
                <figure class="shot-panel" role="tabpanel" id={`panel-${s.id}`} aria-labelledby={`tab-${s.id}`} hidden={i !== 0}>
                  <div class="window"><div class="shot-scroll" tabindex="0" role="group" aria-label={`${s.tab} screenshot, scrolls sideways on small screens`}>
                    <img class="for-light" src={`/screenshots/${s.id}-light.png`} alt={s.alt} width="1280" height="800" loading={i === 0 ? 'eager' : 'lazy'} decoding="async" />
                    <img class="for-dark" src={`/screenshots/${s.id}-dark.png`} alt={s.alt} width="1280" height="800" loading="lazy" decoding="async" />
                  </div></div>
                  <figcaption>{s.cap} <a href={`/screenshots/${s.id}-light.png`} target="_blank" rel="noopener">Open full size</a></figcaption>
                </figure>
              ))}
            </div>
          </div>
        </div>
      </section>

      <section class="section" id="what">
        <div class="wrap">
          <div class="section-head"><h2>What it does</h2></div>
          <ul class="spec">
            {spec.map(([h, p]) => (
              <li><h3>{h}</h3><p>{p}</p></li>
            ))}
          </ul>
        </div>
      </section>

      <section class="section tint" id="quickstart">
        <div class="wrap">
          <div class="section-head"><h2>Run it yourself</h2></div>
          <div class="quick">
            <div class="notes">
              <p><strong>Self-hostable.</strong> One Next.js app plus Postgres, with a Docker image and a Compose file. MIT licensed.</p>
              <p><strong>You need a GitHub App first.</strong> The setup guide covers the read-only permissions, the events and the webhook.</p>
              <p><strong>The install script does the rest.</strong> On Linux, macOS or WSL with Docker, it asks four questions, generates the secrets, starts the app and Postgres and waits until it is healthy. Then sign in as admin, enter your GitHub App under Admin &gt; Workspace configuration and press Run first sync. Read the script before you run it if you prefer.</p>
              <p><a class="btn violet" href={`${repo}/blob/main/docs/github-app-setup.md`} rel="noopener">GitHub App setup guide</a></p>
            </div>
            <div class="code">
              <button class="copy" type="button" id="copy">Copy</button>
              <pre id="snippet"><code><span class="c"># after creating your GitHub App (needs Docker with Compose v2)</span>
curl -fsSL https://raw.githubusercontent.com/Dash-AI-Tools/doc-my-repos/v0.1.0/install.sh | sh
<span class="c"># open the address it prints, sign in, then</span>
<span class="c"># Admin &gt; Workspace configuration &gt; Run first sync</span>

<span class="c"># or from a clone, with Docker Compose</span>
git clone https://github.com/Dash-AI-Tools/doc-my-repos.git
cd doc-my-repos
cp .env.example .env
docker compose up -d --build --wait</code></pre>
            </div>
          </div>
        </div>
      </section>

  <Fragment slot="close">
    <div class="close">
      <h2>Try it on your own org.</h2>
      <p class="hud-cta">
        <a class="btn" href={repo} rel="noopener">View on GitHub <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 11h11.2l-4.6-4.6L12 5l7 7-7 7-1.4-1.4 4.6-4.6H4v-2Z"/></svg></a>
        <a class="btn ghost" href={`${repo}/blob/main/CONTRIBUTING.md`} rel="noopener">Contributing</a>
        <a class="btn ghost" href={`${repo}/blob/main/LICENSE`} rel="noopener">MIT license</a>
      </p>
    </div>
  </Fragment>
</Base>

<script>
      // screenshot tabs
      const tabs = [...document.querySelectorAll<HTMLButtonElement>('[role=tab]')];
      const select = (btn: HTMLButtonElement) => {
        tabs.forEach((t) => {
          const on = t === btn;
          t.setAttribute('aria-selected', String(on));
          t.tabIndex = on ? 0 : -1;
          document.getElementById(t.getAttribute('aria-controls')!)!.hidden = !on;
        });
      };
      tabs.forEach((t, i) => {
        t.addEventListener('click', () => select(t));
        t.addEventListener('keydown', (e) => {
          const k = (e as KeyboardEvent).key;
          const step = k === 'ArrowRight' || k === 'ArrowDown' ? 1 : k === 'ArrowLeft' || k === 'ArrowUp' ? -1 : 0;
          if (!step) return;
          e.preventDefault();
          const n = tabs[(i + step + tabs.length) % tabs.length];
          n.focus();
          select(n);
        });
      });

</script>
