---
import Base from '../../layouts/Base.astro';
import { getPosts } from '../../lib/ghost';
import { formatDate } from '../../lib/format';

const posts = await getPosts();
---
<Base
  title="Blog · Dash AI"
  description="Notes from Dash AI on building with AI: the tools we make, how we use them, and what we learn."
  current="blog"
  canonical={Astro.site ? new URL('/blog/', Astro.site).href : undefined}
>
  <section class="page-top">
    <div class="wrap">
      <p class="crumb"><a href="/">Home</a><span aria-hidden="true">/</span><span>Blog</span></p>
      <div class="page-head">
        <h1>Blog</h1>
        <p class="lede">Notes on building with AI: the tools we make, how we use them, and what we learn along the way.</p>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      {posts.length === 0 ? (
        <p class="empty">No posts have been published yet. Check back soon.</p>
      ) : (
        <ul class="post-list">
          {posts.map((p) => (
            <li>
              <a class="post-row" href={`/blog/${p.slug}/`}>
                <div class="post-meta">
                  <time datetime={p.published_at}>{formatDate(p.published_at)}</time>
                  {p.primary_tag && <span class="post-tag">{p.primary_tag.name}</span>}
                </div>
                <div>
                  <h2>{p.title}</h2>
                  <p>{p.excerpt}</p>
                </div>
              </a>
            </li>
          ))}
        </ul>
      )}
    </div>
  </section>
</Base>
