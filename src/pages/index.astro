---
import Base from '../layouts/Base.astro';
import Plate from '../components/Plate.astro';
import Character from '../components/Character.astro';

const org = 'https://github.com/Dash-AI-Tools';

const ideas = [
  'Docs and knowledge tools',
  'Code review helpers',
  'Testing and QA',
  'Spec-driven workflow',
  'Agent and MCP tooling',
  'Observability for AI work',
];
---
<Base
  title="Dash AI Open Source"
  description="Small open-source tools from Dash AI for people who build with AI: DocMyRepos for your docs, openspec-hud for your spec flow. Tell us what to build next."
  current="home"
>
      <section class="hero">
        <div class="wrap">
          <div class="hero-head">
            <h1>Small open-source tools for people who build with <em><span class="ai">AI</span></em>.</h1>
            <p class="sub">Dash AI makes focused tools for the work around AI-assisted development: finding your docs, and keeping track of your spec flow. DocMyRepos is live and openspec-hud is on its way, both on GitHub.</p>
          </div>

          <div class="roster three">
            <Plate kind="guest" tone="lilac" name="DocMyRepos" quote="DOCS SEARCH" born="Live · MIT · born 9 Oct 2026"
              line="Search and showcase the Markdown docs of every repository in your GitHub org, in one place you host yourself." href="/doc-my-repos/" style="--i:0">
              <ul class="proof" aria-label="At a glance"><li>Self-hosted</li><li>Markdown + OKF</li></ul>
              <span class="plate-link">See DocMyRepos <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 11h11.2l-4.6-4.6L12 5l7 7-7 7-1.4-1.4 4.6-4.6H4v-2Z"/></svg></span>
            </Plate>
            <Plate kind="egg" tone="sky" name="openspec-hud" quote="OPENSPEC STATUS" born="Coming soon"
              line="A Claude Code mod that tracks the status of your OpenSpec flow, and the stats that matter while you build." href="/openspec-hud/" style="--i:1">
              <span class="plate-link">See openspec-hud <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 11h11.2l-4.6-4.6L12 5l7 7-7 7-1.4-1.4 4.6-4.6H4v-2Z"/></svg></span>
            </Plate>
            <Plate kind="egg" tone="mint" name="Your idea" quote="WHAT NEXT?" born="Not hatched yet"
              line="Dash AI is picking its next tool. Tell us what you wish existed." href="#next" style="--i:2">
              <span class="plate-link">Suggest what&#8217;s next <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M11 4v11.2l-4.6-4.6L5 12l7 7 7-7-1.4-1.4-4.6 4.6V4h-2Z"/></svg></span>
            </Plate>
          </div>
        </div>
      </section>

      <section class="section" id="about">
        <div class="wrap about">
          <Character kind="guest" class="about-char" />
          <div class="section-head">
            <h2>About Dash <span class="ai">AI</span>.</h2>
            <p>Dash AI builds small, focused tools for developers who work with AI. Each one does one job, is open source, and lives in the open on GitHub, so you can read it, run it and change it.</p>
            <p>The next tool comes from what people actually need. That is what the question below is for.</p>
          </div>
          <a class="btn" href={org} rel="noopener">See the Dash-AI-Tools org
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 11h11.2l-4.6-4.6L12 5l7 7-7 7-1.4-1.4 4.6-4.6H4v-2Z"/></svg>
          </a>
        </div>
      </section>

      <section class="section tint" id="next">
        <div class="wrap">
          <div class="section-head survey-head">
            <Character kind="egg" class="survey-char" />
            <h2>What should we build next?</h2>
            <p>Pick any that would help you, or describe your own. Sending needs a free GitHub account.</p>
          </div>
          <form class="survey" id="survey" novalidate>
            <fieldset>
              <legend class="sr">Areas I would use a new tool in</legend>
              <div class="chips">
                {ideas.map((t, i) => (
                  <label class="chip"><input type="checkbox" name="idea" value={t} /><span>{t}</span></label>
                ))}
              </div>
            </fieldset>
            <label class="field">
              <span>Or tell us what you wish existed</span>
              <textarea name="other" rows="4" maxlength="800" placeholder="A tool that…"></textarea>
            </label>
            <div class="survey-row">
              <button class="btn violet" type="submit" id="survey-send">Send your idea</button>
              <p class="survey-note" id="survey-note" role="status" aria-live="polite">This opens a prefilled GitHub issue you can submit.</p>
            </div>
          </form>
        </div>
      </section>

  <Fragment slot="close">
    <div class="close">
      <h2>Read the code. Run it. Tell us what&#8217;s next.</h2>
      <Character kind="lead" />
      <a class="btn" href={org} rel="noopener">See the org on GitHub
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 11h11.2l-4.6-4.6L12 5l7 7-7 7-1.4-1.4 4.6-4.6H4v-2Z"/></svg>
      </a>
    </div>
  </Fragment>
</Base>

<script>
      // survey: open a prefilled issue in Dash-AI-Tools/home
      const form = document.getElementById('survey') as HTMLFormElement | null;
      form?.addEventListener('submit', (e) => {
        e.preventDefault();
        const note = document.getElementById('survey-note')!;
        const picks = [...form.querySelectorAll<HTMLInputElement>('input[name=idea]:checked')].map((i) => i.value);
        const other = (form.elements.namedItem('other') as HTMLTextAreaElement).value.trim();
        if (!picks.length && !other) { note.textContent = 'Pick at least one area or write an idea first.'; return; }
        const body = `Areas:\n${picks.map((p) => '- ' + p).join('\n') || '- (none picked)'}\n\nIdea:\n${other || '(none)'}`;
        const url = 'https://github.com/Dash-AI-Tools/home/issues/new?title=' + encodeURIComponent('What should Dash AI build next?') + '&body=' + encodeURIComponent(body);
        open(url, '_blank', 'noopener');
        note.textContent = 'Opened a prefilled GitHub issue. Submit it there to send your idea.';
      });

</script>
