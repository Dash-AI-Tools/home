---
import Base from '../layouts/Base.astro';
import ProjectLogo from '../components/ProjectLogo.astro';

const org = 'https://github.com/Dash-AI-Tools';

const ideas = [
  'Docs and knowledge tools',
  'Code review helpers',
  'Testing and QA',
  'Spec-driven workflow',
  'Agent and MCP tooling',
  'Observability for AI work',
];
---
<Base
  title="Dash AI Open Source"
  description="Small open-source tools from Dash AI for people who build with AI: DocMyRepos for your docs, openspec-hud for your OpenSpec flow in Claude Code. Tell us what to build next."
  current="home"
>
  <section class="hero">
    <div class="wrap hero-grid">
      <div class="hero-copy">
        <h1>Small open&#8209;source tools for people who build with <span class="ai">AI</span>.</h1>
        <p class="sub">Dash AI makes focused tools for the work around AI-assisted development: finding your docs, and keeping track of your spec flow. Both are live on GitHub.</p>
        <p class="hero-cta">
          <a class="btn" href="#projects">Browse the projects <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M11 4v11.2l-4.6-4.6L5 12l7 7 7-7-1.4-1.4-4.6 4.6V4h-2Z"/></svg></a>
          <a class="btn ghost" href={org} rel="noopener">GitHub org</a>
        </p>
      </div>
    </div>
  </section>

  <section class="section" id="projects">
    <div class="wrap">
      <div class="section-head">
        <h2>Projects</h2>
        <p>Each tool does one job, is open source, and lives on GitHub.</p>
      </div>
      <ul class="register">
        <li>
          <a class="reg-row" href="/doc-my-repos/">
            <div class="reg-name"><span class="status">Live</span><h3><ProjectLogo class="reg-logo" project="doc-my-repos" name="DocMyRepos" ext="png" w={1640} h={496} /></h3></div>
            <div class="reg-desc-col">
              <p class="reg-desc">Search and showcase the Markdown docs of every repository in your GitHub org, with Ask the docs and MCP access for AI agents, in one place you host yourself.</p>
              <ul class="reg-meta"><li>MIT</li><li>TypeScript</li><li>Self-hosted</li><li>Markdown + OKF</li></ul>
            </div>
            <span class="reg-go" aria-label="See DocMyRepos"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 11h11.2l-4.6-4.6L12 5l7 7-7 7-1.4-1.4 4.6-4.6H4v-2Z"/></svg></span>
          </a>
        </li>
        <li>
          <a class="reg-row" href="/openspec-hud/">
            <div class="reg-name"><span class="status">Live</span><h3><ProjectLogo class="reg-logo" project="openspec-hud" name="openspec-hud" ext="svg" w={396} h={64} /></h3></div>
            <div class="reg-desc-col">
              <p class="reg-desc">A Claude Code mod that shows your OpenSpec flow in a side panel: flow step, tasks, running agents, context and usage.</p>
              <ul class="reg-meta"><li>v0.3.0</li><li>TypeScript</li><li>Claude Code</li></ul>
            </div>
            <span class="reg-go" aria-label="See openspec-hud"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 11h11.2l-4.6-4.6L12 5l7 7-7 7-1.4-1.4 4.6-4.6H4v-2Z"/></svg></span>
          </a>
        </li>
        <li>
          <a class="reg-row next" href="#next">
            <div class="reg-name"><span class="status open">Open slot</span><h3>Your idea</h3></div>
            <div class="reg-desc-col">
              <p class="reg-desc">Dash AI is picking its next tool. Tell us what you wish existed.</p>
            </div>
            <span class="reg-go" aria-label="Suggest what's next"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M11 4v11.2l-4.6-4.6L5 12l7 7 7-7-1.4-1.4-4.6 4.6V4h-2Z"/></svg></span>
          </a>
        </li>
      </ul>
    </div>
  </section>

  <section class="section tint" id="about">
    <div class="wrap about">
      <div class="section-head" style="margin:0">
        <h2>About Dash <span class="ai">AI</span></h2>
      </div>
      <div class="about-copy">
        <p>Dash AI builds small, focused tools for developers who work with AI. Each one does one job, is open source, and lives in the open on GitHub, so you can read it, run it and change it.</p>
        <p>The next tool comes from what people actually need. That is what the question below is for.</p>
        <a class="btn ghost" href={org} rel="noopener">See the Dash-AI-Tools org <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 11h11.2l-4.6-4.6L12 5l7 7-7 7-1.4-1.4 4.6-4.6H4v-2Z"/></svg></a>
      </div>
    </div>
  </section>

  <section class="section" id="next">
    <div class="wrap survey-wrap">
      <div class="section-head">
        <h2>What should we build next?</h2>
        <p>Pick any that would help you, or describe your own. Sending needs a free GitHub account.</p>
      </div>
      <form class="survey" id="survey" novalidate>
        <fieldset>
          <legend class="sr">Areas I would use a new tool in</legend>
          <div class="chips">
            {ideas.map((t) => (
              <label class="chip"><input type="checkbox" name="idea" value={t} /><span>{t}</span></label>
            ))}
          </div>
        </fieldset>
        <label class="field">
          <span>Or tell us what you wish existed</span>
          <textarea name="other" rows="4" maxlength="800" placeholder="A tool that…"></textarea>
        </label>
        <div class="survey-row">
          <button class="btn violet" type="submit" id="survey-send">Send your idea</button>
          <p class="survey-note" id="survey-note" role="status" aria-live="polite">This opens a prefilled GitHub issue you can submit.</p>
        </div>
      </form>
    </div>
  </section>

  <Fragment slot="close">
    <div class="close">
      <h2>Read the code. Run it. Tell us what&#8217;s next.</h2>
      <p class="hud-cta"><a class="btn" href={org} rel="noopener">See the org on GitHub <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 11h11.2l-4.6-4.6L12 5l7 7-7 7-1.4-1.4 4.6-4.6H4v-2Z"/></svg></a></p>
    </div>
  </Fragment>
</Base>

<script>
      // survey: open a prefilled issue in Dash-AI-Tools/home
      const form = document.getElementById('survey') as HTMLFormElement | null;
      form?.addEventListener('submit', (e) => {
        e.preventDefault();
        const note = document.getElementById('survey-note')!;
        const picks = [...form.querySelectorAll<HTMLInputElement>('input[name=idea]:checked')].map((i) => i.value);
        const other = (form.elements.namedItem('other') as HTMLTextAreaElement).value.trim();
        if (!picks.length && !other) { note.textContent = 'Pick at least one area or write an idea first.'; return; }
        const body = `Areas:\n${picks.map((p) => '- ' + p).join('\n') || '- (none picked)'}\n\nIdea:\n${other || '(none)'}`;
        const url = 'https://github.com/Dash-AI-Tools/home/issues/new?title=' + encodeURIComponent('What should Dash AI build next?') + '&body=' + encodeURIComponent(body);
        open(url, '_blank', 'noopener');
        note.textContent = 'Opened a prefilled GitHub issue. Submit it there to send your idea. Thank you.';
        form.classList.remove('sent'); void form.offsetWidth; form.classList.add('sent');
      });

</script>
<script>
      // live count on the send button
      const sf = document.getElementById('survey') as HTMLFormElement | null;
      const sb = document.getElementById('survey-send');
      sf?.addEventListener('change', () => {
        const n = sf.querySelectorAll('input[name=idea]:checked').length;
        if (sb) sb.textContent = n ? `Send ${n} ${n === 1 ? 'idea' : 'ideas'}` : 'Send your idea';
      });
</script>
