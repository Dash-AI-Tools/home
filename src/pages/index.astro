---
import '@fontsource-variable/fredoka';
import '@fontsource-variable/figtree';
import '../styles/global.css';
import Mark from '../components/Mark.astro';
import Plate from '../components/Plate.astro';
import Character from '../components/Character.astro';

const org = 'https://github.com/Dash-AI-Tools';
const repo = `${org}/doc-my-repos`;

const ideas = [
  'Docs and knowledge tools',
  'Code review helpers',
  'Testing and QA',
  'Spec-driven workflow',
  'Agent and MCP tooling',
  'Observability for AI work',
];
const shots = [
  { id: 'home', tab: 'Home', alt: 'The DocMyRepos home page: a search box and a grid of repository cards', cap: 'One search box and one card per synced repository.' },
  { id: 'repo', tab: 'Repo space', alt: 'A repository page with its README, the documentation tree and the code owners panel', cap: 'Each repository gets its README, its code owners and a tree of its docs folder.' },
  { id: 'doc', tab: 'A document', alt: 'A document page with code blocks, a table, a task list and a Mermaid diagram, next to an outline and the documentation tree', cap: 'GitHub-flavored Markdown with highlighted code and Mermaid diagrams, beside an outline.' },
  { id: 'search', tab: 'Search', alt: 'Search results for the word deployment with highlighted snippets and repository, type and tag filters', cap: 'Full-text search across every repo, with highlighted snippets and filters.' },
  { id: 'palette', tab: 'Ctrl/Cmd+K', alt: 'The quick search palette listing documents that match deployment', cap: 'The command palette jumps to any document from anywhere.' },
  { id: 'okf-metadata', tab: 'OKF metadata', alt: 'A document page with its OKF metadata card: type, status, tags, sources, dates and other fields', cap: 'Repos that use Open Knowledge Format also get a metadata card for each document.' },
];

const spec = [
  ['Repo spaces', 'Every repository you choose gets its own space: the main README, the code owners from CODEOWNERS and a tree of the docs folder.'],
  ['One search', 'Postgres full-text search across all synced repos, weighted by title, headings, description and body, with highlighted snippets and a Ctrl/Cmd+K palette.'],
  ['Safe Markdown', 'Plain GitHub-flavored Markdown with Shiki highlighting and Mermaid diagrams. Documents are untrusted: output is sanitized and .mdx is never executed.'],
  ['OKF filters', 'When a repo uses Open Knowledge Format, filter by concept type, tags and status. Repos without it show no OKF interface.'],
  ['Read-only access', 'It installs as a read-only GitHub App, never a personal access token. GitHub is not called while you browse: pages and search read Postgres only.'],
  ['Stays fresh', 'GitHub webhooks re-sync a repo when its default branch changes, and a scheduled full sync catches missed deliveries. A failed sync keeps the previous content.'],
];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Dash AI Open Source</title>
    <meta name="description" content="Small open-source tools from Dash AI for people who build with AI: DocMyRepos for your docs, openspec-hud for your spec flow. Tell us what to build next." />
    <meta name="theme-color" content="#12224a" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <script is:inline>
      try {
        var t = localStorage.getItem('dash-theme');
        if (t === 'light' || t === 'dark') document.documentElement.dataset.theme = t;
      } catch (e) {}
    </script>
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="wrap">
        <a class="brand" href="/" aria-label="Dash AI home">
          <Mark class="mark" /><span><b>Dash</b> <span>AI</span></span>
        </a>
        <nav class="nav" aria-label="Main">
          <a class="hide-s" href="#see-it">See it</a>
          <a class="hide-s" href="#openspec-hud">openspec-hud</a>
          <a class="hide-s" href="#next">What&#8217;s next</a>
          <a href={org} rel="noopener">GitHub</a>
          <button class="theme" type="button" id="theme" aria-label="Switch theme">
            <svg class="moon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M20.5 14.2A8.5 8.5 0 0 1 9.8 3.5a.8.8 0 0 0-1-1A10 10 0 1 0 21.5 15.2a.8.8 0 0 0-1-1Z"/></svg>
            <svg class="sun" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><circle cx="12" cy="12" r="4.5"/><path d="M12 1.5a1 1 0 0 1 1 1V4a1 1 0 1 1-2 0V2.5a1 1 0 0 1 1-1Zm0 18.5a1 1 0 0 1 1 1v1.5a1 1 0 1 1-2 0V21a1 1 0 0 1 1-1ZM1.5 12a1 1 0 0 1 1-1H4a1 1 0 1 1 0 2H2.5a1 1 0 0 1-1-1Zm18.5 0a1 1 0 0 1 1-1h1.5a1 1 0 1 1 0 2H21a1 1 0 0 1-1-1ZM4.6 4.6a1 1 0 0 1 1.4 0l1 1A1 1 0 0 1 5.6 7l-1-1a1 1 0 0 1 0-1.4Zm12.4 12.4a1 1 0 0 1 1.4 0l1 1a1 1 0 0 1-1.4 1.4l-1-1a1 1 0 0 1 0-1.4ZM19.4 4.6a1 1 0 0 1 0 1.4l-1 1A1 1 0 0 1 17 5.6l1-1a1 1 0 0 1 1.4 0ZM7 17a1 1 0 0 1 0 1.4l-1 1A1 1 0 0 1 4.6 18l1-1A1 1 0 0 1 7 17Z"/></svg>
          </button>
        </nav>
      </div>
    </header>

    <main id="main">
      <section class="hero">
        <div class="wrap">
          <div class="hero-head">
            <h1>Small open-source tools for people who build with <em><span class="ai">AI</span></em>.</h1>
            <p class="sub">Dash AI makes focused tools for the work around AI-assisted development: finding your docs, and keeping track of your spec flow. DocMyRepos is live and openspec-hud is on its way, both on GitHub.</p>
          </div>

          <div class="roster three">
            <Plate kind="guest" tone="lilac" name="DocMyRepos" quote="DOCS SEARCH" born="Live · MIT · born 9 Oct 2026"
              line="Search and showcase the Markdown docs of every repository in your GitHub org, in one place you host yourself." href={repo} style="--i:0">
              <ul class="proof" aria-label="At a glance"><li>Self-hosted</li><li>Markdown + OKF</li></ul>
              <span class="plate-link">View on GitHub <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 11h11.2l-4.6-4.6L12 5l7 7-7 7-1.4-1.4 4.6-4.6H4v-2Z"/></svg></span>
            </Plate>
            <Plate kind="egg" tone="sky" name="openspec-hud" quote="OPENSPEC STATUS" born="Coming soon"
              line="A Claude Code mod that tracks the status of your OpenSpec flow, and the stats that matter while you build." href={`${org}/openspec-hud`} style="--i:1">
              <span class="plate-link">Follow the repo <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 11h11.2l-4.6-4.6L12 5l7 7-7 7-1.4-1.4 4.6-4.6H4v-2Z"/></svg></span>
            </Plate>
            <Plate kind="egg" tone="mint" name="Your idea" quote="WHAT NEXT?" born="Not hatched yet"
              line="Dash AI is picking its next tool. Tell us what you wish existed." href="#next" style="--i:2">
              <span class="plate-link">Suggest what&#8217;s next <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M11 4v11.2l-4.6-4.6L5 12l7 7 7-7-1.4-1.4-4.6 4.6V4h-2Z"/></svg></span>
            </Plate>
          </div>
        </div>
      </section>

      <section class="section" id="about">
        <div class="wrap about">
          <Character kind="guest" class="about-char" />
          <div class="section-head">
            <h2>About Dash <span class="ai">AI</span>.</h2>
            <p>Dash AI builds small, focused tools for developers who work with AI. Each one does one job, is open source, and lives in the open on GitHub, so you can read it, run it and change it.</p>
            <p>The next tool comes from what people actually need. That is what the question below is for.</p>
          </div>
          <a class="btn" href={org} rel="noopener">See the Dash-AI-Tools org
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 11h11.2l-4.6-4.6L12 5l7 7-7 7-1.4-1.4 4.6-4.6H4v-2Z"/></svg>
          </a>
        </div>
      </section>

      <section class="section tint" id="see-it">
        <div class="wrap">
          <div class="section-head">
            <h2>DocMyRepos, the real thing.</h2>
            <p>These are DocMyRepos screenshots, generated from seeded demo data. They follow your light or dark theme.</p>
          </div>
          <div class="shots">
            <div class="shot-tabs" role="tablist" aria-label="Screenshots">
              {shots.map((s, i) => (
                <button role="tab" type="button" id={`tab-${s.id}`} aria-controls={`panel-${s.id}`} aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1}>{s.tab}</button>
              ))}
            </div>
            <div class="shot-stage">
              {shots.map((s, i) => (
                <figure class="shot-panel" role="tabpanel" id={`panel-${s.id}`} aria-labelledby={`tab-${s.id}`} hidden={i !== 0}>
                  <div class="shot-scroll" tabindex="0" role="group" aria-label={`${s.tab} screenshot, scrolls sideways on small screens`}>
                    <img class="for-light" src={`/screenshots/${s.id}-light.png`} alt={s.alt} width="1280" height="800" loading={i === 0 ? 'eager' : 'lazy'} decoding="async" />
                    <img class="for-dark" src={`/screenshots/${s.id}-dark.png`} alt={s.alt} width="1280" height="800" loading="lazy" decoding="async" />
                  </div>
                  <figcaption>{s.cap} <a href={`/screenshots/${s.id}-light.png`} target="_blank" rel="noopener">Open full size</a></figcaption>
                </figure>
              ))}
            </div>
          </div>
        </div>
      </section>

      <section class="section" id="what">
        <div class="wrap">
          <div class="section-head"><h2>What DocMyRepos does, in plain words.</h2></div>
          <ul class="spec">
            {spec.map(([h, p]) => (
              <li><h3>{h}</h3><p>{p}</p></li>
            ))}
          </ul>
        </div>
      </section>

      <section class="section tint" id="quickstart">
        <div class="wrap">
          <div class="section-head"><h2>Run DocMyRepos yourself.</h2></div>
          <div class="quick">
            <div class="notes">
              <p><strong>Self-hostable.</strong> One Next.js app plus Postgres, with a Docker image and a Compose file. MIT licensed.</p>
              <p><strong>You need a GitHub App first.</strong> The setup guide covers the read-only permissions, the events and the webhook.</p>
              <p><a class="btn violet" href={`${repo}/blob/main/docs/github-app-setup.md`} rel="noopener">GitHub App setup guide</a></p>
            </div>
            <div class="code">
              <button class="copy" type="button" id="copy">Copy</button>
              <pre id="snippet"><code><span class="c"># after creating your GitHub App</span>
git clone https://github.com/Dash-AI-Tools/doc-my-repos.git
cd doc-my-repos
cp .env.example .env
<span class="c"># fill in the GitHub App values and secrets in .env</span>
docker compose up -d --build --wait
<span class="c"># then open http://127.0.0.1:3000</span></code></pre>
            </div>
          </div>
        </div>
      </section>

      <section class="section" id="openspec-hud">
        <div class="wrap">
          <div class="plate tone-sky hud-plate">
            <Character kind="egg" class="hud-char" />
            <div class="hud-copy">
              <span class="quote">"OPENSPEC STATUS"</span>
              <span class="name">openspec-hud</span>
              <h2>Your OpenSpec flow, tracked from inside Claude Code.</h2>
              <p>A Claude Code mod that tracks the status of your OpenSpec flow and the stats that matter while you develop. The repo is public, but there is no code in it yet, so there is nothing to install today.</p>
              <p class="hud-cta"><span class="status">Coming soon</span> <a class="btn ghost" href={`${org}/openspec-hud`} rel="noopener">Follow openspec-hud on GitHub</a></p>
            </div>
          </div>
        </div>
      </section>

      <section class="section tint" id="next">
        <div class="wrap">
          <div class="section-head survey-head">
            <Character kind="egg" class="survey-char" />
            <h2>What should we build next?</h2>
            <p>Pick any that would help you, or describe your own. Sending needs a free GitHub account.</p>
          </div>
          <form class="survey" id="survey" novalidate>
            <fieldset>
              <legend class="sr">Areas I would use a new tool in</legend>
              <div class="chips">
                {ideas.map((t, i) => (
                  <label class="chip"><input type="checkbox" name="idea" value={t} /><span>{t}</span></label>
                ))}
              </div>
            </fieldset>
            <label class="field">
              <span>Or tell us what you wish existed</span>
              <textarea name="other" rows="4" maxlength="800" placeholder="A tool that…"></textarea>
            </label>
            <div class="survey-row">
              <button class="btn violet" type="submit" id="survey-send">Send your idea</button>
              <p class="survey-note" id="survey-note" role="status" aria-live="polite">This opens a prefilled GitHub issue you can submit.</p>
            </div>
          </form>
        </div>
      </section>

    </main>

    <footer class="site-footer">
      <div class="wrap">
        <div class="close">
          <h2>Read the code. Run it. Tell us what&#8217;s next.</h2>
          <Character kind="lead" />
          <a class="btn" href={repo} rel="noopener">View on GitHub
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 11h11.2l-4.6-4.6L12 5l7 7-7 7-1.4-1.4 4.6-4.6H4v-2Z"/></svg>
          </a>
        </div>
        <div class="foot-row">
          <span>© 2026 Dash AI. Open-source tools.</span>
          <nav aria-label="Footer">
            <a href={org} rel="noopener">GitHub org</a>
            <a href={repo} rel="noopener">DocMyRepos</a>
            <a href={`${org}/openspec-hud`} rel="noopener">openspec-hud</a>
            <a href={`${repo}/blob/main/CONTRIBUTING.md`} rel="noopener">Contributing</a>
          </nav>
        </div>
      </div>
    </footer>

    <script>
      const root = document.documentElement;
      const themeBtn = document.getElementById('theme');
      themeBtn?.addEventListener('click', () => {
        const dark = matchMedia('(prefers-color-scheme: dark)').matches;
        const cur = root.dataset.theme ?? (dark ? 'dark' : 'light');
        const next = cur === 'dark' ? 'light' : 'dark';
        root.dataset.theme = next;
        try { localStorage.setItem('dash-theme', next); } catch {}
      });

      // screenshot tabs
      const tabs = [...document.querySelectorAll<HTMLButtonElement>('[role=tab]')];
      const select = (btn: HTMLButtonElement) => {
        tabs.forEach((t) => {
          const on = t === btn;
          t.setAttribute('aria-selected', String(on));
          t.tabIndex = on ? 0 : -1;
          document.getElementById(t.getAttribute('aria-controls')!)!.hidden = !on;
        });
      };
      tabs.forEach((t, i) => {
        t.addEventListener('click', () => select(t));
        t.addEventListener('keydown', (e) => {
          const k = (e as KeyboardEvent).key;
          const step = k === 'ArrowRight' || k === 'ArrowDown' ? 1 : k === 'ArrowLeft' || k === 'ArrowUp' ? -1 : 0;
          if (!step) return;
          e.preventDefault();
          const n = tabs[(i + step + tabs.length) % tabs.length];
          n.focus();
          select(n);
        });
      });

      // copy
      const copy = document.getElementById('copy');
      copy?.addEventListener('click', async () => {
        const text = document.getElementById('snippet')!.textContent ?? '';
        try {
          await navigator.clipboard.writeText(text);
          copy.textContent = 'Copied';
        } catch {
          copy.textContent = 'Press Ctrl/Cmd+C';
        }
        setTimeout(() => (copy.textContent = 'Copy'), 1800);
      });

      // survey: open a prefilled issue in Dash-AI-Tools/home
      const form = document.getElementById('survey') as HTMLFormElement | null;
      form?.addEventListener('submit', (e) => {
        e.preventDefault();
        const note = document.getElementById('survey-note')!;
        const picks = [...form.querySelectorAll<HTMLInputElement>('input[name=idea]:checked')].map((i) => i.value);
        const other = (form.elements.namedItem('other') as HTMLTextAreaElement).value.trim();
        if (!picks.length && !other) { note.textContent = 'Pick at least one area or write an idea first.'; return; }
        const body = `Areas:\n${picks.map((p) => '- ' + p).join('\n') || '- (none picked)'}\n\nIdea:\n${other || '(none)'}`;
        const url = 'https://github.com/Dash-AI-Tools/home/issues/new?title=' + encodeURIComponent('What should Dash AI build next?') + '&body=' + encodeURIComponent(body);
        open(url, '_blank', 'noopener');
        note.textContent = 'Opened a prefilled GitHub issue. Submit it there to send your idea.';
      });

      // eyes follow the pointer
      if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
        const pupils = [...document.querySelectorAll<SVGCircleElement>('.pupil')];
        addEventListener('pointermove', (e) => {
          for (const p of pupils) {
            const svg = p.ownerSVGElement!;
            const r = svg.getBoundingClientRect();
            const k = 1770 / r.width;
            const px = r.left + Number(p.dataset.px) / k;
            const py = r.top + Number(p.dataset.py) / k;
            const dx = (e.clientX - px) * k, dy = (e.clientY - py) * k;
            const d = Math.hypot(dx, dy) || 1;
            const m = Math.min(34, d);
            p.style.transform = `translate(${(dx / d) * m}px, ${(dy / d) * m}px)`;
          }
        });
      }
    </script>
  </body>
</html>
